             <property name="styleSheet">
              <string notr="true">QComboBox {
    background-color: #2b2b2b; /* Fondo gris oscuro */
    color: white;              /* Texto blanco */
    border: 1px solid #555555; /* Borde gris sutil */
    border-radius: 4px;        /* Bordes ligeramente redondeados */
    padding: 5px;              /* Espacio interno para que el texto respire */
}

QComboBox:hover {
    border: 1px solid #888888; /* El borde se ilumina un poco al pasar el ratón */
}

/* Estilo de la lista que se abre hacia abajo */
QComboBox QAbstractItemView {
    background-color: #2b2b2b; 
    color: white;              
    selection-background-color: #0984e3; /* Fondo azul (mismo del botón) al seleccionar */
    selection-color: white;
}</string>
