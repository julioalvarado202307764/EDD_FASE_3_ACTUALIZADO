           <item row="3" column="1">
            <widget class="QSpinBox" name="spinFilas">
             <property name="styleSheet">
              <string notr="true">/* Campo principal */
QSpinBox {
    background-color: #2b2b2b;
    border: 1px solid #3d3d3d;
    border-radius: 5px;
    color: #ffffff;
    padding: 4px 8px;
    font-size: 13px;
}

QSpinBox:focus {
    border: 1px solid #1E90FF;
}

/* Contenedor del botón superior */
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    background-color: #383838;
    border-top-right-radius: 4px;
    border-left: 1px solid #3d3d3d;
    border-bottom: 1px solid #2b2b2b;
}

QSpinBox::up-button:hover {
    background-color: #1E90FF;
}

QSpinBox::up-button:pressed {
    background-color: #1674cc;
}

/* Triángulo Arriba mediante bordes puros */
QSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #ffffff;
}

/* Contenedor del botón inferior */
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    background-color: #383838;
    border-bottom-right-radius: 4px;
    border-left: 1px solid #3d3d3d;
}

QSpinBox::down-button:hover {
    background-color: #1E90FF;
}

QSpinBox::down-button:pressed {
    background-color: #1674cc;
}

/* Triángulo Abajo mediante bordes puros */
QSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #ffffff;
}</string>
             </property>
            </widget>
           </item>
